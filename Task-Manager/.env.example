# Copie este arquivo para ".env" e ajuste os valores conforme seu ambiente
# Configuração do Servidor
port=3000

# Configuração do Banco de Dados MongoDB
# Formato: mongodb://host:porta/nome-do-banco
# Exemplo local: mongodb://localhost:27017/projeto1
# Exemplo MongoDB Atlas: mongodb+srv://usuario:senha@cluster.mongodb.net/projeto1
db=mongodb://localhost:27017/projeto1
